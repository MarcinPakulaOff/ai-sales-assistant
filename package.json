  },
  "dependencies": {
    "express": "5.1.0",
    "nodemailer": "7.0.6"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "20.19.17",
    "@types/nodemailer": "7.0.1",
    "typescript": "5.9.2"
  }
}
