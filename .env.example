PORT=3000
PUBLIC_URL=https://assistant.example.com
LEADS_FILE=./data/leads.json
OUTBOX_DIR=./data/outbox-sent

# Telegram: "direct" (token here) or "n8n" (token stays in n8n, see n8n/)
TELEGRAM_MODE=direct
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
N8N_TELEGRAM_WEBHOOK=http://127.0.0.1:5678/webhook/assistant-out

# Shared with scanner/imap_scan.py
EVENT_TOKEN=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hello@example.com
SMTP_PASS=
SENDER_NAME=Your Name · Company

CARD_USER=
CARD_PASS=
SIGNATURE=Your Name\nCompany · example.com
REVIEW_URL=https://g.page/r/your-review-link
