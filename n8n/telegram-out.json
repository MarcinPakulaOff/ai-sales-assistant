    {
      "id": "61786146-ad7b-4f43-9c2c-cc271ef59b40",
      "name": "Localhost only + prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Assistant → owner's Telegram. The bot token stays in n8n and never touches the assistant host.\n// Localhost only: anything that came through the reverse proxy carries X-Forwarded-For — rejected.\n// BUTTONS: the Telegram node does not accept a whole inline keyboard as one expression (n8n silently\n// sends an empty one), hence fixed layouts: rows of command buttons + one link button (the card).\n// Layout = row lengths, e.g. \"3-3\". Unknown layout → the link goes into the text instead.\nconst SHAPES = ['3-3', '3', '2', '2-1', '0'];\nconst it = $input.first().json;\nconst h = it.headers || {};\nif (h['x-forwarded-for'] || h['x-real-ip']) return [];\nconst b = it.body || {};\nconst p = b.payload || {};\nconst hour = Number(new Intl.DateTimeFormat('pl-PL', { timeZone: 'Europe/Warsaw', hour: '2-digit', hour12: false }).format(new Date()));\nconst silent = hour >= 22 || hour < 7;\nif (b.method === 'answerCallbackQuery') {\n  return [{ json: { method: b.method, queryId: String(p.callback_query_id || ''), text: String(p.text || 'OK').slice(0, 190) } }];\n}\nif (b.method !== 'sendMessage') return [];\nlet text = String(p.text || '').slice(0, 3900);\nconst rows = (p.reply_markup || {}).inline_keyboard || [];\nconst cb = rows.map((r) => r.filter((x) => x.callback_data).map((x) => ({ text: String(x.text), data: String(x.callback_data) }))).filter((r) => r.length);\nconst urlBtn = rows.flat().find((x) => x.url);\nconst u = urlBtn ? { text: String(urlBtn.text), url: String(urlBtn.url) } : { text: '🗂 Pipeline', url: 'https://assistant.example.com/cards' };\nlet shape = rows.length ? cb.map((r) => r.length).join('-') || '0' : 'none';\nif (shape !== 'none' && !SHAPES.includes(shape)) {\n  text += `\\n\\n🗂 ${u.url}`;\n  shape = 'none';\n}\nreturn [{ json: { method: b.method, text, shape, b: cb, u, silent } }];"
      }
    },
